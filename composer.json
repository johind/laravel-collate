{
    "name": "johind/collate",
    "description": "Laravel PDF package to merge, split, extract pages, watermark, encrypt, and optimize PDFs using qpdf.",
    "keywords": [
        "laravel",
        "pdf",
        "qpdf",
        "pdf-manipulation",
        "merge-pdf",
        "split-pdf",
        "ai-preparation"
    ],
    "homepage": "https://github.com/johind/collate",
    "license": "MIT",
    "authors": [
        {
            "name": "Jori Hinderfeld",
            "email": "hello@johind.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/process": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "league/flysystem": "^3.0",
        "league/flysystem-local": "^3.0",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/http-foundation": "^7.0 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Johind\\Collate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Johind\\Collate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest --parallel",
        "test:ci": "vendor/bin/pest --ci",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "analyse:tests": "vendor/bin/phpstan analyse --configuration phpstan-tests.neon.dist",
        "rector": "vendor/bin/rector process --dry-run --no-progress-bar",
        "rector:all": "@rector",
        "rector:fix": "vendor/bin/rector process",
        "format": "vendor/bin/pint --parallel",
        "format:check": "vendor/bin/pint --test",
        "check": [
            "@test",
            "@analyse",
            "@analyse:tests",
            "@rector",
            "@format:check"
        ],
        "check:strict": [
            "@check"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Johind\\Collate\\CollateServiceProvider"
            ],
            "aliases": {
                "Collate": "Johind\\Collate\\Facades\\Collate"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
